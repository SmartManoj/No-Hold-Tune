<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smart.noholdtone"
    android:versionCode="6"
    android:versionName="4.2">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />

    <!-- signature|appop; Telecom only binds non-UI InCallServices holding it. Granted by the
         COMPANION_DEVICE_WATCH role after pairing in the app (or: adb shell appops set
         com.smart.noholdtone MANAGE_ONGOING_CALLS allow) -->
    <uses-permission android:name="android.permission.MANAGE_ONGOING_CALLS" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_PROFILE_WATCH" />
    <uses-feature android:name="android.software.companion_device_setup" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_action_call">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Non-UI InCallService; bound by Telecom because of MANAGE_ONGOING_CALLS above -->
        <service
            android:name=".CallWatchService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
    </application>
</manifest>
